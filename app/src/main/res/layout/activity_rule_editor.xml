<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/AppTextButton"
            android:text="@string/back"
            app:icon="@drawable/ic_back" />
        <TextView
            style="@style/PageTitle"
            android:text="@string/edit_rule" />
        <TextView
            style="@style/BodyText"
            android:text="@string/editor_detailed_hint"
            android:layout_marginBottom="20dp" />
        <com.google.android.material.card.MaterialCardView
            style="@style/AppCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/app_identity" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTextInput"
                    android:hint="@string/display_name_label">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/displayName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:autofillHints=""
                        android:maxLength="40" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTextInput"
                    android:hint="@string/package_name_label"
                    app:helperText="@string/package_helper">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/packageName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textVisiblePassword"
                        android:autofillHints=""
                        android:maxLength="255" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/AppCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/recognition_settings" />
                <TextView style="@style/SectionTitle" android:text="@string/expense_keywords_label"
                    android:layout_marginTop="12dp" />
                <TextView style="@style/BodyText" android:text="@string/keywords_helper" />
                <LinearLayout android:id="@+id/expenseConditions"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addExpenseCondition" style="@style/AppTextButton"
                    android:text="@string/add_expense_condition" app:icon="@drawable/ic_add" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/applyPreset"
                    style="@style/AppTextButton"
                    android:text="@string/apply_payment_preset"
                    android:visibility="gone" />
                <TextView style="@style/SectionTitle" android:text="@string/excluded_keywords_label"
                    android:layout_marginTop="12dp" />
                <TextView style="@style/BodyText" android:text="@string/excluded_helper" />
                <LinearLayout android:id="@+id/excludedConditions"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addExcludedCondition" style="@style/AppTextButton"
                    android:text="@string/add_excluded_condition" app:icon="@drawable/ic_add" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/rule_enabled" />
                <TextView
                    style="@style/BodyText"
                    android:text="@string/parser_help" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/AppCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/test_section" />
                <TextView
                    style="@style/BodyText"
                    android:text="@string/test_hint" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTextInput"
                    android:hint="@string/test_sample_label">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sample"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:autofillHints=""
                        android:minLines="2"
                        android:maxLength="4096"
                        android:saveEnabled="false"
                        android:gravity="top|start" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/testButton"
                    style="@style/AppOutlinedButton"
                    android:text="@string/test_rule"
                    android:layout_marginTop="12dp" />
                <TextView
                    android:id="@+id/testResult"
                    style="@style/BodyText"
                    android:accessibilityLiveRegion="polite"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/AppButton"
            android:text="@string/save_rule" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteButton"
            style="@style/AppTextButton"
            android:text="@string/delete_rule"
            android:textColor="@color/error" />
    </LinearLayout>
</ScrollView>
