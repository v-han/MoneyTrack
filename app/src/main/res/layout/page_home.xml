<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/homeSummaryBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:stateListAnimator="@null"
        app:liftOnScroll="false">
        <!-- 标题与筛选区先滚出；金额卡片不设置滚动标记，到顶后保持可见。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            app:layout_scrollFlags="scroll">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/PageTitle" android:layout_width="0dp" android:layout_weight="1"
                    android:text="@string/home_title" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refreshButton" style="@style/AppOutlinedButton"
                    android:layout_width="wrap_content" android:minWidth="0dp" android:minHeight="48dp"
                    android:layout_marginStart="8dp" android:paddingHorizontal="12dp"
                    android:text="@string/refresh_short" android:contentDescription="@string/refresh"
                    android:textSize="13sp" app:icon="@drawable/ic_refresh" app:iconSize="18dp" app:iconPadding="4dp" />
            </LinearLayout>
            <TextView
                style="@style/BodyText"
                android:text="@string/home_subtitle"
                android:layout_marginBottom="20dp" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            style="@style/AppCard"
            android:layout_marginHorizontal="20dp"
            app:cardBackgroundColor="@color/primary_container">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    style="@style/BodyText"
                    android:text="@string/today_total_label"
                    android:textColor="@color/on_primary_container" />
                <TextView
                    android:id="@+id/total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="40sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_primary_container"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/addExpenseButton"
                style="@style/AppButton"
                android:text="@string/add_expense"
                app:icon="@drawable/ic_add"
                android:layout_marginBottom="16dp" />
            <TextView
                android:id="@+id/pendingCount"
                style="@style/BodyText" />
            <TextView
                style="@style/SectionTitle"
                android:text="@string/pending_heading" />
            <LinearLayout
                android:id="@+id/pending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/pendingEmpty"
                style="@style/BodyText"
                android:text="@string/no_pending"
                android:paddingBottom="20dp" />
            <TextView
                style="@style/SectionTitle"
                android:text="@string/today_heading" />
            <LinearLayout
                android:id="@+id/today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/todayEmpty"
                style="@style/BodyText"
                android:text="@string/no_today" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/moreButton"
                style="@style/AppTextButton"
                android:text="@string/load_more" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
