<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/backButton" style="@style/AppTextButton" android:text="@string/back" app:icon="@drawable/ic_back" />
        <TextView style="@style/PageTitle" android:text="@string/notification_configuration" />
        <TextView style="@style/BodyText" android:text="@string/notification_configuration_hint" android:layout_marginBottom="20dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/rulesButton" style="@style/AppButton" android:text="@string/manage_rules" />
        <com.google.android.material.button.MaterialButton android:id="@+id/linksButton" style="@style/AppOutlinedButton" android:text="@string/notification_links" />
        <com.google.android.material.button.MaterialButton android:id="@+id/transferButton" style="@style/AppOutlinedButton" android:text="@string/rule_transfer_title" />
        <TextView android:id="@+id/summary" style="@style/BodyText" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
